NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27018/bookhaven?replicaSet=rs0&directConnection=true
# Transactions require replica set — use docker-compose mongo or Atlas
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BookHaven <noreply@bookhaven.local>

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FREE_SHIPPING_THRESHOLD=999
SHIPPING_FLAT_RATE=49
COD_ENABLED=true

ADMIN_BOOTSTRAP_EMAIL=admin@bookhaven.local
ADMIN_BOOTSTRAP_PASSWORD=

UPLOAD_MAX_MB=5
